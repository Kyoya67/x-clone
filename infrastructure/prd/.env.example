# 8〜128文字の表示可能ASCII（空白・/・ダブルクォート・@を除く）。実際の値はGitへ登録しない。
TF_VAR_dbadmin_password=''
# パスワード変更時に増やす。RDSとSecrets Managerで同じ値を使う。
TF_VAR_dbadmin_password_version=1

# Cognito Hosted UIでGoogleログインを使うためのOAuth Client。
# 実際の値はGitへ登録しない。
TF_VAR_google_client_id=''
TF_VAR_google_client_secret=''

# BFFがhttpOnly Cookieのsession署名に使うSecret。十分長いランダム文字列を設定する。
TF_VAR_auth_session_secret=''
TF_VAR_auth_secret_version=1
